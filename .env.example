# OpenClaw Environment Configuration
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets.

# --- Required ---

# Gateway authentication token (64-char hex string).
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- Paths ---

# Where OpenClaw stores its configuration (provider keys, device list, etc.)
OPENCLAW_CONFIG_DIR=~/.openclaw

# Agent workspace directory (sandboxed file access for the AI)
OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# --- Docker Image ---

# Use "openclaw:local" if you build from source, or a registry image.
OPENCLAW_IMAGE=openclaw:local

# --- Networking ---

# Host port for the gateway WebSocket (accessed via SSH tunnel)
OPENCLAW_GATEWAY_PORT=18789

# Host port for the bridge service
OPENCLAW_BRIDGE_PORT=18790

# Gateway bind mode inside the container.
# "lan"      = bind to all container interfaces (correct for Docker)
# "loopback" = bind to 127.0.0.1 only (breaks container networking)
# Always use "lan" in Docker deployments.
OPENCLAW_GATEWAY_BIND=lan

# --- Claude AI Session (optional) ---
# These suppress Docker Compose warnings for variables the image may reference.
# Leave blank unless you have session credentials to inject.
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# --- Build-time (optional) ---

# Extra apt packages to install in the Docker image (space-separated)
# OPENCLAW_DOCKER_APT_PACKAGES=ffmpeg build-essential

# Named Docker volume for /home/node persistence across rebuilds
# OPENCLAW_HOME_VOLUME=openclaw_home
